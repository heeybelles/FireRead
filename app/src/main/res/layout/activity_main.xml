<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_screen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título e Subtítulo -->
        <TextView
            android:id="@+id/textTituloMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro de Produto"
            android:textColor="@color/blue_primary_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textSubtituloMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Preencha os dados para salvar no Firestore"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/labelNome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTituloMain" />

        <!-- Campo Nome do Produto -->
        <TextView
            android:id="@+id/labelNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nome do Produto"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/edtNome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textSubtituloMain" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/selector_edit_text"
            android:hint="Ex: Notebook Gamer"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint_color"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/labelCategoria"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelNome" />

        <!-- Campo Categoria -->
        <TextView
            android:id="@+id/labelCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Categoria"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/edtCategoria"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtNome" />

        <EditText
            android:id="@+id/edtCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/selector_edit_text"
            android:hint="Ex: Eletrônicos"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint_color"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/labelPreco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelCategoria" />

        <!-- Campo Preço -->
        <TextView
            android:id="@+id/labelPreco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Preço (R$)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/edtPreco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtCategoria" />

        <EditText
            android:id="@+id/edtPreco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/selector_edit_text"
            android:hint="Ex: 2499.90"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint_color"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/btnSalvar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelPreco" />

        <!-- Botão Salvar (Azul Principal) -->
        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/blue_primary"
            android:text="Salvar no Firestore"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toTopOf="@id/btnVerLista"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtPreco" />

        <!-- Botão Ver Lista (Azul Secundário) -->
        <Button
            android:id="@+id/btnVerLista"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_secondary"
            android:text="Ver Lista de Produtos"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSalvar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
